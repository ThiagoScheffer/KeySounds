<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeySounds.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="KeySounds.MainWindow" Width="1100" Height="760" MinWidth="900" MinHeight="650" Title="KeySounds">
  <TabControl Margin="20" SelectedIndex="{Binding SelectedTabIndex}">
    <TabItem Header="Dashboard">
      <ScrollViewer><StackPanel Margin="18" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock FontSize="30" FontWeight="SemiBold" Text="KeySounds"/>
        <ToggleSwitch IsChecked="{Binding IsEnabled}" OnContent="Keyboard sounds enabled" OffContent="Keyboard sounds disabled"/>
        <Grid ColumnDefinitions="150,320" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
          <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Active profile"/><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
          <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Global volume"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlobalVolume}" TickFrequency="0.05"/>
        </Grid>
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Grid.Row="0" Text="Input" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InputStatus}"/>
          <TextBlock Grid.Row="1" Text="Audio" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioStatus}"/>
          <TextBlock Grid.Row="2" Text="Sound packs" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoundPackStatus}"/>
          <TextBlock Grid.Row="3" Text="Sample cache" FontWeight="SemiBold"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SampleCacheStatus}"/>
          <TextBlock Grid.Row="4" Text="Triggers" FontWeight="SemiBold"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ClickCount}"/>
          <TextBlock Grid.Row="5" Text="Keyboard path" FontWeight="SemiBold"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TriggerDiagnostics}"/>
          <TextBlock Grid.Row="6" Text="Keyboards" FontWeight="SemiBold"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding KeyboardSummary}"/>
          <TextBlock Grid.Row="7" Text="Output" FontWeight="SemiBold"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AudioPage.EffectiveOutput}"/>
          <TextBlock Grid.Row="8" Text="Recent status" FontWeight="SemiBold"/><TextBlock Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" Text="{Binding RecentWarning}"/>
        </Grid>
        <TextBlock Text="{Binding ProfilesPage.ProfileCount, StringFormat='Saved profiles: {0}'}"/>
        <TextBlock Text="{Binding ProfilesPage.IsDirty, StringFormat='Editor has unsaved changes: {0}'}"/>
        <TextBlock Text="{Binding AudioPage.EngineSummary}"/>
        <TextBlock Text="{Binding AudioPage.EffectiveOutput, StringFormat='Current output: {0}'}"/>
        <TextBlock Text="{Binding AudioPage.FallbackStatus}"/>
        <Border Background="#16000000" CornerRadius="6" Padding="14"><TextBlock TextWrapping="Wrap" Text="Privacy: key events are processed transiently. Typed text is not stored or transmitted. Local keyboard identity metadata is used only for optional profile assignments."/></Border>
        <TextBlock Foreground="Crimson" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/><TextBlock Foreground="DarkGoldenrod" TextWrapping="Wrap" Text="{Binding SettingsStatus}"/>
      </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Profiles" DataContext="{Binding ProfilesPage}">
      <Grid x:DataType="vm:ProfilesPageViewModel" Margin="12" ColumnDefinitions="280,12,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="Profiles"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileListItemViewModel"><StackPanel Margin="6"><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock FontSize="12" Opacity="0.75" Text="{Binding Status}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="2"><Button Margin="0,0,6,6" Content="New" Command="{Binding CreateCommand}"/><Button Margin="0,0,6,6" Content="Duplicate" Command="{Binding DuplicateCommand}"/><Button Margin="0,0,6,6" Content="Delete" Command="{Binding DeleteCommand}"/><Button Margin="0,0,6,6" Content="Import" Command="{Binding ImportCommand}"/><Button Margin="0,0,6,6" Content="Export" Command="{Binding ExportCommand}"/></WrapPanel>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="#30000000"/>
        <ScrollViewer Grid.Column="2" DataContext="{Binding Editor}">
          <StackPanel x:DataType="vm:ProfileEditorViewModel" Margin="16,0" Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="24" FontWeight="SemiBold" Text="Profile editor"/><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding IsDirty, StringFormat='Unsaved: {0}'}"/></Grid>
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <TextBlock Grid.Row="0" Text="Name"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
              <TextBlock Grid.Row="1" Text="Description"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}"/>
              <TextBlock Grid.Row="2" Text="Master volume"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MasterVolume}"/>
              <TextBlock Grid.Row="3" Text="Playback"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16"><CheckBox IsChecked="{Binding Enabled}" Content="Enabled"/><CheckBox IsChecked="{Binding PlayOnKeyDown}" Content="Key down"/><CheckBox IsChecked="{Binding PlayOnKeyUp}" Content="Key up"/></StackPanel>
              <TextBlock Grid.Row="4" Text="Repeat mode"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding RepeatMode}"/>
              <TextBlock Grid.Row="5" Text="Repeat interval (ms)"/><NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="20" Maximum="2000" Value="{Binding RepeatInterval}"/>
            </Grid>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Key groups"/>
            <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GroupEditorViewModel">
              <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8"><StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding Enabled}"/><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/></StackPanel>
                <Grid ColumnDefinitions="100,150,90,150,80,150" ColumnSpacing="8"><TextBlock Text="Pack"/><ComboBox Grid.Column="1" ItemsSource="{Binding Packs}" SelectedItem="{Binding PackId}"/><TextBlock Grid.Column="2" Text="Down set"/><ComboBox Grid.Column="3" ItemsSource="{Binding SoundSets}" SelectedItem="{Binding DownSetId}"/><Button Grid.Column="4" Content="Preview" Command="{Binding PreviewDownCommand}"/></Grid>
                <Grid ColumnDefinitions="100,150,90,150,80,150" ColumnSpacing="8"><TextBlock Text="Up set"/><ComboBox Grid.Column="1" ItemsSource="{Binding SoundSets}" SelectedItem="{Binding UpSetId}"/><Button Grid.Column="2" Content="Preview" Command="{Binding PreviewUpCommand}"/><TextBlock Grid.Column="3" Text="Variation"/><ComboBox Grid.Column="4" Grid.ColumnSpan="2" ItemsSource="{Binding VariationModes}" SelectedItem="{Binding VariationMode}"/></Grid>
                <Grid ColumnDefinitions="100,*,100,*,120,*" ColumnSpacing="8"><TextBlock Text="Volume"/><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}"/><TextBlock Grid.Column="2" Text="Pitch ± semitones"/><Slider Grid.Column="3" Minimum="0" Maximum="3" Value="{Binding PitchVariation}"/><TextBlock Grid.Column="4" Text="Volume variation"/><Slider Grid.Column="5" Minimum="0" Maximum="0.2" Value="{Binding VolumeVariation}"/></Grid>
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Per-key overrides"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Capture key" Command="{Binding CaptureCommand}"/><Button Content="Cancel capture" Command="{Binding CancelCaptureCommand}"/><TextBlock VerticalAlignment="Center" Text="{Binding CaptureStatus}"/></StackPanel>
            <ItemsControl ItemsSource="{Binding Overrides}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OverrideEditorViewModel"><Grid ColumnDefinitions="110,Auto,95,95,95,80,80,80,120,Auto" Margin="0,4" ColumnSpacing="6"><TextBlock Text="{Binding Label}"/><CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="Enabled"/><TextBox Grid.Column="2" PlaceholderText="Optional pack" Text="{Binding PackId}"/><TextBox Grid.Column="3" PlaceholderText="Down set" Text="{Binding DownSetId}"/><TextBox Grid.Column="4" PlaceholderText="Up set" Text="{Binding UpSetId}"/><NumericUpDown Grid.Column="5" Minimum="0" Maximum="1" Value="{Binding Volume}"/><NumericUpDown Grid.Column="6" Minimum="0" Maximum="3" Value="{Binding PitchVariation}"/><NumericUpDown Grid.Column="7" Minimum="0" Maximum="0.2" Increment="0.01" Value="{Binding VolumeVariation}"/><ComboBox Grid.Column="8" ItemsSource="{Binding VariationModes}" SelectedItem="{Binding VariationMode}"/><Button Grid.Column="9" Content="Remove" Command="{Binding RemoveCommand}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Background="#12FF0000" Padding="10"><TextBlock TextWrapping="Wrap" Text="{Binding ValidationSummary}"/></Border>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save" Command="{Binding $parent[TabItem].DataContext.SaveCommand}"/><Button Content="Save and activate" Command="{Binding $parent[TabItem].DataContext.SaveAndActivateCommand}"/><Button Content="Activate saved" Command="{Binding $parent[TabItem].DataContext.ActivateCommand}"/><Button Content="Revert" Command="{Binding RevertCommand}"/></StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding $parent[TabItem].DataContext.Status}"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>
    <TabItem Header="Sound Packs" DataContext="{Binding SoundPacksPage}">
      <Grid x:DataType="vm:SoundPacksViewModel" Margin="12" ColumnDefinitions="330,12,*" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Sound Packs"/>
            <TextBlock Text="{Binding Summary}"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding MissingPackReferences}"/>
          </StackPanel>
          <WrapPanel Grid.Column="1">
            <Button Margin="0,0,8,8" Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Margin="0,0,8,8" Content="Import sound pack" Command="{Binding ImportCommand}"/>
            <Button Margin="0,0,8,8" Content="Cleanup storage" Command="{Binding CleanupCommand}"/>
          </WrapPanel>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#14007ACC" BorderBrush="#28007ACC" BorderThickness="1" CornerRadius="8" Padding="12" DataContext="{Binding Creator}">
          <StackPanel x:DataType="vm:SoundPackCreatorViewModel" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}"/>
                <TextBlock TextWrapping="Wrap" Text="Create or edit a pack by adding WAV files to sound-set buckets. Drafts validate before they can replace an installed pack."/>
              </StackPanel>
              <WrapPanel Grid.Column="1">
                <Button Margin="0,0,8,8" Content="Create Pack" Command="{Binding CreateCommand}"/>
                <Button Margin="0,0,8,8" Content="Edit Selected" Command="{Binding EditCommand}"/>
                <Button Margin="0,0,8,8" Content="Save Pack" Command="{Binding SaveCommand}"/>
                <Button Margin="0,0,8,8" Content="Save Pack + Create Profile" Command="{Binding SaveAndCreateProfileCommand}"/>
                <Button Margin="0,0,8,8" Content="Cancel" Command="{Binding CancelCommand}"/>
              </WrapPanel>
            </Grid>
            <Grid ColumnDefinitions="120,180,80,200,80,160,100,*" ColumnSpacing="8" IsVisible="{Binding IsEditing}">
              <TextBlock VerticalAlignment="Center" Text="Pack ID"/><TextBox Grid.Column="1" Text="{Binding PackId}"/>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Name"/><TextBox Grid.Column="3" Text="{Binding Name}"/>
              <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Author"/><TextBox Grid.Column="5" Text="{Binding Author}"/>
              <CheckBox Grid.Column="6" VerticalAlignment="Center" Content="Activate profile" IsChecked="{Binding ActivateGeneratedProfile}"/>
              <TextBox Grid.Column="7" PlaceholderText="Description" Text="{Binding Description}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
              <TextBlock TextWrapping="Wrap" Foreground="DarkGoldenrod" Text="{Binding Status}"/>
              <Button Grid.Column="1" Content="Add sound set" Command="{Binding AddSetCommand}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Sets}" IsVisible="{Binding IsEditing}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SoundPackDraftSetViewModel">
                  <Border Width="300" MinHeight="160" Margin="0,0,10,10" Padding="10" BorderBrush="#30000000" BorderThickness="1" CornerRadius="6" Background="#0CFFFFFF"
                          DragDrop.AllowDrop="True" DragDrop.Drop="SoundPackDraftSetDrop">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Id}"/>
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="Remove" Command="{Binding RemoveSetCommand}"/>
                      </Grid>
                      <TextBox PlaceholderText="Display name" Text="{Binding Name}"/>
                      <TextBlock FontWeight="SemiBold" Text="{Binding SampleCount, StringFormat='Samples: {0}'}"/>
                      <TextBlock TextWrapping="Wrap" Text="{Binding FilesSummary}"/>
                      <TextBlock FontSize="12" Opacity="0.75" Text="Drop WAV files onto this card, or use Add WAV files."/>
                      <Button Content="Add WAV files…" Command="{Binding AddFilesCommand}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="330,12,*">
          <Grid RowDefinitions="*,Auto" RowSpacing="10">
            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SoundPackRowViewModel">
                  <Border Margin="4" Padding="8" BorderBrush="#26000000" BorderThickness="1" CornerRadius="5">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                      <TextBlock FontSize="12" Text="{Binding Id}"/>
                      <TextBlock FontSize="12" Text="{Binding LocationType}"/>
                      <TextBlock FontSize="12" Text="{Binding ValidationStatus}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding RemovalEligibility}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Spacing="8">
              <Button Content="Remove selected user pack" Command="{Binding RemoveCommand}"/>
              <TextBlock Foreground="DarkGoldenrod" TextWrapping="Wrap" Text="{Binding StatusText}"/>
            </StackPanel>
          </Grid>
          <Border Grid.Column="1" Width="1" Background="#30000000"/>
          <ScrollViewer Grid.Column="2" DataContext="{Binding Selected}">
            <StackPanel x:DataType="vm:SoundPackRowViewModel" Margin="16,0" Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding ValidationStatus}"/>
              </Grid>
              <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Pack ID" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}"/>
                <TextBlock Grid.Row="1" Text="Author" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Author}"/>
                <TextBlock Grid.Row="2" Text="Description" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Description}"/>
                <TextBlock Grid.Row="3" Text="Schema version" FontWeight="SemiBold"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SchemaVersion}"/>
                <TextBlock Grid.Row="4" Text="Location" FontWeight="SemiBold"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LocationType}"/>
                <TextBlock Grid.Row="5" Text="Sound sets" FontWeight="SemiBold"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SoundSetCount}"/>
                <TextBlock Grid.Row="6" Text="Samples" FontWeight="SemiBold"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SampleCount}"/>
                <TextBlock Grid.Row="7" Text="Estimated decoded" FontWeight="SemiBold"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding EstimatedMemory}"/>
                <TextBlock Grid.Row="8" Text="Loaded samples" FontWeight="SemiBold"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LoadedSampleCount}"/>
                <TextBlock Grid.Row="9" Text="Required by" FontWeight="SemiBold"/><TextBlock Grid.Row="9" Grid.Column="1" TextWrapping="Wrap" Text="{Binding ReferencedBy}"/>
              </Grid>
              <Border Background="#16000000" CornerRadius="6" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Removal and recovery"/>
                  <TextBlock TextWrapping="Wrap" Text="{Binding RemovalEligibility}"/>
                  <TextBlock TextWrapping="Wrap" Text="{Binding MissingReferences}"/>
                </StackPanel>
              </Border>
              <Border Background="#12FF0000" CornerRadius="6" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Validation issues"/>
                  <TextBlock TextWrapping="Wrap" Text="{Binding ValidationIssues}"/>
                </StackPanel>
              </Border>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Sound sets"/>
              <ItemsControl ItemsSource="{Binding SoundSets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SoundSetRowViewModel">
                    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                            <TextBlock FontSize="12" Text="{Binding Id}"/>
                            <TextBlock Text="{Binding SampleCount, StringFormat='Samples: {0}'}"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ReferencedFiles}"/>
                            <TextBlock Text="{Binding LoadedState}"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="Preview set" Command="{Binding PreviewCommand}"/>
                        </Grid>
                        <TextBlock Foreground="DarkGoldenrod" Text="{Binding Status}"/>
                        <ItemsControl ItemsSource="{Binding Samples}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundPackSampleViewModel">
                              <Grid ColumnDefinitions="*,100,110,Auto" Margin="0,3" ColumnSpacing="8">
                                <TextBlock Text="{Binding Path}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}"/>
                                <TextBlock Grid.Column="2" Text="{Binding DecodedSize}"/>
                                <Button Grid.Column="3" Content="Preview sample" Command="{Binding PreviewCommand}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem Header="Keyboards" DataContext="{Binding KeyboardsPage}">
      <Grid x:DataType="vm:KeyboardsViewModel" Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Keyboards"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding GlobalProfile, StringFormat='Global active profile: {0}'}"/><Button Grid.Column="1" Content="Refresh keyboards" Command="{Binding RefreshCommand}"/></Grid>
        <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KeyboardRowViewModel">
          <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10"><Grid ColumnDefinitions="*,280" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Grid.Row="1" Text="{Binding Reliability}"/><TextBlock Grid.Row="2" Text="{Binding Instances}"/>
            <TextBlock Grid.Row="3" Text="{Binding AssignedProfile, StringFormat='Assigned profile: {0}'}"/><TextBlock Grid.Row="4" Text="{Binding EffectiveProfileName, StringFormat='Effective profile: {0}'}"/>
            <StackPanel Grid.Column="1" Grid.RowSpan="5" Spacing="8"><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/><WrapPanel><Button Margin="0,0,6,6" Content="Apply assignment" Command="{Binding ApplyCommand}"/><Button Margin="0,0,6,6" Content="Clear" Command="{Binding ClearCommand}"/><Button Margin="0,0,6,6" Content="Preview" Command="{Binding PreviewCommand}"/></WrapPanel><TextBlock Text="{Binding RuntimeStatus}"/><TextBlock TextWrapping="Wrap" Text="{Binding Message}"/></StackPanel>
          </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" Text="{Binding Status}"/>
      </Grid>
    </TabItem>
    <TabItem Header="Audio" DataContext="{Binding AudioPage}">
      <ScrollViewer><StackPanel x:DataType="vm:AudioSettingsViewModel" Margin="24" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Audio output"/>
        <Grid ColumnDefinitions="180,420" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
          <TextBlock Grid.Row="0" Text="Configured output" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfiguredOutput}"/>
          <TextBlock Grid.Row="1" Text="Currently active" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EffectiveOutput}"/>
          <TextBlock Grid.Row="2" Text="Runtime mode" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FallbackStatus}"/>
          <TextBlock Grid.Row="3" Text="Engine" FontWeight="SemiBold"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EngineSummary}"/>
          <TextBlock Grid.Row="4" Text="Output selection"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"/>
          <TextBlock Grid.Row="5" Text="Shared-mode latency"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Latencies}" SelectedItem="{Binding SelectedLatency}"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Text="Lower latency may be less stable on some devices. Changes briefly pause playback while the output is reinitialized."/>
        <WrapPanel><Button Margin="0,0,8,8" Content="Refresh devices" Command="{Binding RefreshCommand}"/><Button Margin="0,0,8,8" Content="Apply output" Command="{Binding ApplyCommand}"/><Button Margin="0,0,8,8" Content="Use system default" Command="{Binding UseDefaultCommand}"/><Button Margin="0,0,8,8" Content="Retry configured device" Command="{Binding RetryCommand}"/><Button Margin="0,0,8,8" Content="Test sound" Command="{Binding TestSoundCommand}"/></WrapPanel>
        <Border Background="#16000000" CornerRadius="6" Padding="12"><TextBlock TextWrapping="Wrap" Text="{Binding Message}"/></Border>
      </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Settings" DataContext="{Binding SettingsPage}">
      <ScrollViewer><StackPanel x:DataType="vm:SettingsViewModel" Margin="24" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Settings and About"/>
        <Border Background="#16000000" CornerRadius="6" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="First run"/>
            <TextBlock TextWrapping="Wrap" Text="KeySounds runs locally. Keyboard events are processed transiently so sounds can play in the background; typed text and key sequences are not stored."/>
            <CheckBox Content="Sounds enabled" IsChecked="{Binding SoundsEnabled}"/>
            <CheckBox Content="Close to tray" IsChecked="{Binding CloseToTray}"/>
            <CheckBox Content="Start with Windows (opt-in)" IsChecked="{Binding StartWithWindows}"/>
            <Button Content="Complete first-run setup" Command="{Binding CompleteFirstRunCommand}"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="14">
          <TextBlock Grid.Row="0" Text="Start with Windows"/><CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding StartWithWindows}"/>
          <TextBlock Grid.Row="1" Text="Minimize to tray"/><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
          <TextBlock Grid.Row="2" Text="Close to tray"/><CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding CloseToTray}"/>
          <TextBlock Grid.Row="3" Text="Show window on startup"/><CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ShowWindowOnStartup}"/>
          <TextBlock Grid.Row="4" Text="Enable local crash reports"/><CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding EnableLocalCrashReports}"/>
          <TextBlock Grid.Row="5" Text="First-run completed"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HasCompletedFirstRun}"/>
        </Grid>
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics"/>
          <TextBlock TextWrapping="Wrap" Text="Diagnostics export is local and sanitized. It contains aggregate state, counts, and runtime metadata; it does not include typed text, key sequences, raw device handles, or raw HID paths."/>
          <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="About"/>
          <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding AppDataPath, StringFormat='App data: {0}'}"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding PrivacySummary}"/>
        </StackPanel>
        <TextBlock Foreground="DarkGoldenrod" TextWrapping="Wrap" Text="{Binding Status}"/>
      </StackPanel></ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
